# Environnements virtuels
.venv/
.venv-1/
.venv-2/
.venv-embed/

# Python
__pycache__/
*.pyc

# Fichiers Excel temporaires / verrous
~$*.xlsx

# Sorties générées (contiennent les noms/titres extraits des documents du
# corpus, données personnelles d'autres étudiant·e·s) : non versionnées
# par défaut.
statistiques_structure_corpus.xlsx
grille_observation_corpus.xlsx
sortie_terminal.txt

# Le corpus lui-même (mémoires/thèses de tiers) n'est pas dans ce dossier,
# mais on l'exclut explicitement par précaution s'il y était copié un jour.
corpus/

# Artefacts binaires générés par les scripts de test des embeddings
# (vecteurs, chunks picklés) : régénérables, pas de source à versionner.
vecteurs_ref.npy
chunks_ref.pkl

# Encodage complet du corpus (vecteurs + métadonnées contenant le texte des
# chunks des 63 documents, donc des tiers) et son checkpoint de reprise.
vecteurs_corpus.npy
metadonnees_corpus.parquet
checkpoint_encodage.json

# Voie lexicale TF-IDF (matrice, vocabulaire et correspondance dérivés du
# texte des 63 documents de tiers).
tfidf_corpus.npz
vocabulaire_tfidf.txt
correspondance_tfidf.parquet
